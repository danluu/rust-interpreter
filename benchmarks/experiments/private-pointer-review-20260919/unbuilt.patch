+#[test]
+fn scalar_promotion_private_pointer_slots_preserve_pointee_aliases() {
+    // These are pointers to offset48, not pointers to the promoted slots16/24.
+    // A write through one copy must remain visible through the other copy.
+    let p=program(function(vec![
+        Op::Imm{dst:0,value:11},Op::Local{dst:1,offset:48},Op::Store{address:1,src:0,size:8},
+        Op::Local{dst:2,offset:16},Op::Store{address:2,src:1,size:8},
+        Op::Local{dst:3,offset:24},Op::Copy{dst:3,src:2,size:8},
+        Op::Load{dst:4,address:3,size:8},Op::Load{dst:5,address:4,size:8},
+        Op::Imm{dst:6,value:7},Op::Store{address:4,src:6,size:8},
+        Op::Load{dst:7,address:2,size:8},Op::Load{dst:8,address:7,size:8},
+        Op::Binary{dst:9,overflow:10,op:Binary::Add,a:5,b:8,bits:64,signed:false},
+        Op::Local{dst:11,offset:0},Op::Store{address:11,src:9,size:16},Op::Return,
+    ],12));
+    let (out,r)=transformed(&p,&[Slot{offset:16,size:8},Slot{offset:24,size:8}]);
+    assert_eq!(r.slots,2);
+    check(&p,&[],18);check(&out,&[],18);
+}
