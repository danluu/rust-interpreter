@@ -10,6 +10,61 @@ const MISS: &str = "[..] rustc info cache miss[..]";
 const HIT: &str = "[..]rustc info cache hit[..]";
 const UPDATE: &str = "[..]updated rustc info cache[..]";
 
+#[cargo_test]
+fn rustc_info_cache_with_empty_wrappers() {
+    let normal = ("RUSTC_WRAPPER", "rustc-wrapper");
+    let workspace = ("RUSTC_WORKSPACE_WRAPPER", "rustc-workspace-wrapper");
+    for (index, wrappers) in [vec![normal], vec![workspace], vec![normal, workspace]]
+        .into_iter()
+        .enumerate()
+    {
+        let mut config = String::from("[build]\n");
+        for (_, key) in &wrappers {
+            config.push_str(&format!("{key} = 'do-not-execute-me'\n"));
+        }
+        let p = project()
+            .at(format!("empty-wrappers-{index}"))
+            .file("src/main.rs", "fn main() {}")
+            .file(".cargo/config.toml", &config)
+            .build();
+
+        for warm in [false, true] {
+            let mut command = p.cargo("build");
+            command.env("CARGO_LOG", "cargo::util::rustc=debug");
+            for (variable, _) in &wrappers {
+                command.env(variable, "");
+            }
+            command.with_stderr_does_not_contain("[..]rustc info cache disabled[..]");
+            if warm {
+                command
+                    .with_stderr_contains(HIT)
+                    .with_stderr_does_not_contain(MISS)
+                    .with_stderr_does_not_contain(UPDATE);
+            } else {
+                command
+                    .with_stderr_contains(MISS)
+                    .with_stderr_contains(UPDATE)
+                    .with_stderr_does_not_contain(HIT);
+            }
+            command.run();
+        }
+
+        let mut command = p.cargo("build");
+        command
+            .env("CARGO_LOG", "cargo::util::rustc=debug")
+            .env("CARGO_CACHE_RUSTC_INFO", "0");
+        for (variable, _) in &wrappers {
+            command.env(variable, "");
+        }
+        command
+            .with_stderr_contains("[..]rustc info cache disabled[..]")
+            .with_stderr_contains(MISS)
+            .with_stderr_does_not_contain(HIT)
+            .with_stderr_does_not_contain(UPDATE)
+            .run();
+    }
+}
