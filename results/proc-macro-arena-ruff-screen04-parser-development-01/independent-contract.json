  "contract": {
    "artifact": "Exact artifact path and emit fields; one dep-info and one metadata for the selected fixed output. Check each against the actual owned output directory, selected emitted extension and existing dep-info proof. Preserve full raw paths, but do not compare invocation-specific paths without an explicit path mapping.",
    "diagnostic": "Keep full message/code/level/spans/children/rendered. Child diagnostics are untagged; future item diagnostics are tagged. Preserve warning/note/help; reject error, error: internal compiler error and failure-note recursively. Do not discard spanless diagnostics.",
    "future_incompat": "Exact tagged outer key future_incompat_report, nonempty list of exact {diagnostic: tagged Diagnostic}. Preserve every nested field and reject failure diagnostics. Its presence is legitimate even with rc0.",
    "parity": "Retain ordered complete nonartifact check_messages and compare normalized full values across matched arms, including nonempty names and future reports. Keep all raw records. Old normalization does not map replay labels; artifacts need separate exact ownership checks or an explicit per-invocation relative mapping.",
    "roles": "Compare like source states. Original setup/restoration and edited warmup/timed calls are distinct roles; a change in source state is not automatically a parity defect.",
    "selected_kinds": [
      "diagnostic",
      "artifact",
      "unused_extern",
      "future_incompat"
    ],
    "unexpected_kinds": "Reject unknown kinds and section_timing because timings is not selected.",
    "unused_extern": "Exact tagged keys lint_level and unused_extern_names. This fixed command requires force-warn and ordered list[str], accepting empty/nonempty lists. Do not sort, deduplicate, impose identifier regex or raw --extern name membership: to_ident_string can add raw syntax."
  },
