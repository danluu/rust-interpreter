 class AssociationControls(unittest.TestCase):
+    def test_historical_sorted_prefix_then_appended_plan_keeps_complete_catalog(self):
+        def plan_last(role, source, names):
+            plan = str(source/'plan.json')
+            return sorted(name for name in names if name != plan)+[plan]
+        f=Fixture(selection_order=plan_last); catalog=f.catalog()
+        self.assertEqual(len(catalog['records']),8)
+        for predecessor in f.predecessors:
+            source=Path(predecessor['source']); freeze=f.json[str(source/'inputs.json')]
+            names=freeze['snapshot_inputs']; self.assertEqual(names[-1],str(source/'plan.json'))
+            self.assertEqual(names[:-1],sorted(names[:-1])); self.assertNotEqual(names,sorted(names))
+            projection=f.json[str(source/'snapshot-plan.json')]['projection']
+            self.assertEqual(set(projection['files']),set(names)|{str(source/'inputs.json')})
+
+    def test_arbitrary_unique_historical_order_reconstructs_same_complete_catalog(self):
+        def reorder(role, source, names):
+            ordered=sorted(names)
+            return [ordered[-1],ordered[0],*ordered[1:-1]]
+        f=Fixture(selection_order=reorder); catalog=f.catalog()
+        self.assertEqual(len(catalog['records']),8)
+        for predecessor in f.predecessors:
+            source=Path(predecessor['source']); names=f.json[str(source/'inputs.json')]['snapshot_inputs']
+            self.assertNotEqual(names,sorted(names)); self.assertNotEqual(names[-1],str(source/'plan.json'))
+            projection=f.json[str(source/'snapshot-plan.json')]['projection']
+            self.assertEqual(set(projection['files']),set(names)|{str(source/'inputs.json')})
+            self.assertEqual(projection['logical_bytes'],sum(row['size'] for row in projection['files'].values()))
+
+    def test_duplicated_historical_selection_still_rejects_for_each_owner(self):
+        for changed_role in ['beta','native']:
+            with self.subTest(role=changed_role):
+                def duplicate(role, source, names):
+                    return names+[names[0]] if role==changed_role else names
+                f=Fixture(selection_order=duplicate)
+                with self.assertRaisesRegex(ValueError,'complete original logical selection'):f.catalog()
+
