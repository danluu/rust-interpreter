+def loader_command(spec, image):
+    """Independently reconstruct the historical or explicit native probe."""
+    if 'loader_probe' not in spec:
+        return ['/usr/bin/otool', '-l', str(image)]
+    host, version = spec.get('host'), spec.get('compiler')
+    require(type(host) is str and host == 'aarch64-apple-darwin',
+            'unsupported native loader probe host')
+    require(type(version) is str and [line[6:] for line in version.splitlines()
+            if line.startswith('host: ')] == [host],
+            'missing, ambiguous or mismatched native compiler host')
+    declaration = spec['loader_probe']
+    expected = dict(policy='darwin-native-loader-probe-v1', host=host, architecture='arm64')
+    require(type(declaration) is dict and set(declaration) == set(expected)
+            and all(type(declaration[k]) is str and declaration[k] == value
+                    for k, value in expected.items()), 'invalid native loader probe declaration')
+    return ['/usr/bin/otool', '-arch', 'arm64', '-l', str(image)]
+
+
