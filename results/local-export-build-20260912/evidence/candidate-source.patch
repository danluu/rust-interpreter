+        Op::CallIndirect { callee: 13, args: vec![1, 3], arg_sizes: vec![16, 0], destination: 10, result_size: 32 },
+        Op::Allocate { dst: 14, size: 11, align: 15, zeroed: true },
+        Op::Deallocate { pointer: 14, size: 11, align: 15 },
+        Op::Reallocate { dst: 16, pointer: 14, old_size: 11, align: 15, new_size: 17 },
+        Op::FillBytes { address: 3, value: 18, size: 11 },
+        Op::FloatBinary { dst: 19, op: FloatBinary::CopySign, a: 20, b: 21, bits: 64 },
+        Op::FloatUnary { dst: 22, op: FloatUnary::RoundTiesEven, src: 19, bits: 32 },
+        Op::FloatConvert { dst: 23, kind: FloatConversion::IntToFloat { signed: true }, src: 8, from: 128, to: 64 },
+        Op::FloatConvert { dst: 24, kind: FloatConversion::FloatToInt { signed: false }, src: 23, from: 64, to: 32 },
+        Op::FloatConvert { dst: 25, kind: FloatConversion::FloatToFloat, src: 23, from: 64, to: 32 },
+        Op::ResetThreadLocals,
+        Op::RandomBytes { dst: 26, address: 1, size: 11 },
+        Op::CpuFeatureQuery { dst: 27, name: 1, output: 3, output_len: 10, new_data: 14, new_len: 17 },
+        Op::CAllocate { dst: 28, count: 18, size: 11, errno: 10, zeroed: false },
+        Op::CDeallocate { pointer: 28 },
+        Op::CReallocate { dst: 29, pointer: 28, size: 17, errno: 10 },
+        Op::CAlignedAllocate { dst: 30, output: 3, align: 15, size: 11 },
+        Op::RegisterTlsDestructor { callback: 13, argument: 31 },
+        Op::Return,
+    ];
+    program.functions.push(function);
+    program
+}
+
+#[test]
+fn all_program_fields_and_opcode_payloads_match_the_retained_serializer() {
