+        Op::Cast { dst: 8, src: 0, from: 64, to: 64, signed: false },
+        Op::Assert { value: 8, expected: true, message: "kept assertion".into() },
+        Op::Local { dst: 4, offset: 32 },
+        Op::Call { function: 1, args: vec![4], destination: 4 },
+        Op::Imm { dst: 5, value: handle },
+        Op::CallIndirect { callee: 5, args: vec![4], arg_sizes: vec![8], destination: 4, result_size: 8 },
+        Op::Switch { value: 8, cases: vec![(7, 10)], otherwise: 9 },
