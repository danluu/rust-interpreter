+//! Normal artifact encoding; bounded diagnostic serialization stays separate.
+use rust_interp_bytecode::Program;
+
+pub(crate) fn serialize(program: &Program) -> Result<Vec<u8>, String> {
+    // The root helper retains bincode's fixed-width little-endian encoding but
+    // avoids serialize's sizing traversal. Keep partial output private on error.
+    let mut bytes = Vec::new();
+    bincode::serialize_into(&mut bytes, program).map_err(|e| e.to_string())?;
+    Ok(bytes)
+}
+
+#[cfg(test)]
+#[path = "artifact_serialization_tests.rs"]
+mod tests;
