+use super::*;
+
+// Every captured field is nonempty. These addresses are compared, never read
+// through pointers, to distinguish moving retained values from cloning them.
+fn owned_fields(code: &[Op]) -> Vec<usize> {
+    let mut fields = Vec::new();
+    for op in code {
+        match op {
+            Op::Assert { message, .. } | Op::Trap { message } => fields.push(message.as_ptr() as usize),
+            Op::Switch { cases, .. } => fields.push(cases.as_ptr() as usize),
+            Op::Call { args, .. } => fields.push(args.as_ptr() as usize),
+            Op::CallIndirect { args, arg_sizes, .. } => {
+                fields.push(args.as_ptr() as usize);
+                fields.push(arg_sizes.as_ptr() as usize);
+            }
+            _ => {}
+        }
+    }
+    fields
+}
