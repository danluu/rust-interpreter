+#[test]
+fn buffer_growth_preserves_code_strings_and_byte_payloads() {
+    for len in [0, 1, 7, 8, 15, 16, 31, 32, 255, 256, 257, 4095, 4096, 4097] {
+        let mut code = minimal();
+        code.functions[0].registers = 1;
+        code.functions[0].code = (0..len).map(|i| Op::Imm { dst: 0, value: (i as u128) << 96 }).collect();
+        code.functions[0].code.push(Op::Return);
+        let mut strings = minimal();
+        strings.functions[0].name = "λ\0".repeat(len);
+        strings.functions[0].code = vec![Op::Trap { message: "雪".repeat(len) }];
+        let mut payloads = minimal();
+        payloads.data = (0..len).map(|i| i as u8).collect();
