+    let mut aliases = vec![Some((3, 11, old)), Some((4, 12, last)), None];
+    let epoch = advance_alias_epoch(last, &mut aliases);
+    assert_eq!(epoch, NonZeroU32::MIN);
+    assert_eq!(aliases, [None, None, None]);
+    // A normal advance preserves physical entries; their old epoch makes them
+    // logically unavailable. Only wrap needs the full register-table clear.
+    aliases[2] = Some((5, 13, epoch));
+    let next = advance_alias_epoch(epoch, &mut aliases);
