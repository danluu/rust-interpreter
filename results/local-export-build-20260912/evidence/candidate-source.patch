+//! Original allocating verifier retained from d8077a for behavior comparison.
+use super::*;
+
+fn retained_into_shapes(chosen: ChosenLayout, slots: &[Slot], local_extent: usize) -> Vec<(usize, usize)> {
+    let mut end = 0;
+    let uncolored = chosen.shapes.iter().map(|&(size, align)| allocate(&mut end, size, align).unwrap()).collect();
+    let (expected, extent) = match chosen.slots {
+        Some(planned) => (planned, chosen.extent),
+        None => (uncolored, end),
+    };
+    assert_eq!(extent, local_extent, "baseline local extent differs");
+    assert!(expected.len() == slots.len() && expected.iter().zip(slots)
+        .all(|(a, b)| a.offset == b.offset && a.size == b.size), "baseline slots differ");
+    chosen.shapes
+}
+
+#[derive(Debug, PartialEq)]
+enum Outcome { Shapes(Vec<(usize, usize)>), Panic(String) }
+
+fn outcome(f: impl FnOnce() -> Vec<(usize, usize)> + std::panic::UnwindSafe) -> Outcome {
+    match std::panic::catch_unwind(f) {
+        Ok(shapes) => Outcome::Shapes(shapes),
+        Err(error) => {
+            let message = error.downcast_ref::<String>().cloned()
+                .or_else(|| error.downcast_ref::<&str>().map(|message| (*message).to_owned()))
+                .expect("expected a string panic payload");
+            Outcome::Panic(message)
+        }
+    }
+}
+
+fn compare(shapes: &[(usize, usize)], planned: Option<&[Slot]>, chosen_extent: usize,
+           slots: &[Slot], local_extent: usize) -> Outcome {
+    let make = || ChosenLayout { shapes: shapes.to_vec(), slots: planned.map(|slots| slots.to_vec()), extent: chosen_extent };
+    let expected = outcome(|| retained_into_shapes(make(), slots, local_extent));
+    let actual = outcome(|| make().into_shapes(slots, local_extent));
+    assert_eq!(actual, expected);
+    actual
+}
+
+fn slots(offsets: &[usize], size: usize) -> Vec<Slot> {
+    offsets.iter().map(|&offset| Slot { offset, size }).collect()
+}
+
+#[test]
+fn colored_and_dedicated_checks_match_the_original_verifier() {
+    let shapes = [(8, 8); 3];
+    let dedicated = slots(&[0, 8, 16], 8);
+    let colored = slots(&[0, 8, 8], 8);
+    assert_eq!(compare(&shapes, None, 24, &dedicated, 24), Outcome::Shapes(shapes.to_vec()));
+    assert_eq!(compare(&shapes, Some(&colored), 16, &colored, 16), Outcome::Shapes(shapes.to_vec()));
+    // Without a colored layout, the reconstructed extent retains precedence
+    // over the stored original-extent field, as in the original verifier.
+    assert_eq!(compare(&shapes, None, 123, &dedicated, 24), Outcome::Shapes(shapes.to_vec()));
+
+    let shapes = [(0, 16), (3, 1), (8, 8), (0, 32), (1, 1)];
+    let expected = [Slot { offset: 0, size: 0 }, Slot { offset: 0, size: 3 },
+        Slot { offset: 8, size: 8 }, Slot { offset: 32, size: 0 }, Slot { offset: 32, size: 1 }];
+    assert_eq!(compare(&shapes, None, 33, &expected, 33), Outcome::Shapes(shapes.to_vec()));
+    assert_eq!(compare(&[], None, 0, &[], 0), Outcome::Shapes(vec![]));
+    assert_eq!(compare(&[], Some(&[]), 0, &[], 0), Outcome::Shapes(vec![]));
+}
+
+#[test]
+fn both_layout_modes_preserve_slot_and_extent_failure_order() {
+    let shapes = [(8, 8); 3];
+    let dedicated = slots(&[0, 8, 16], 8);
+    let colored = slots(&[0, 8, 8], 8);
+    for planned in [None, Some(colored.as_slice())] {
+        let expected = planned.unwrap_or(&dedicated);
+        let extent = if planned.is_some() { 16 } else { 24 };
+        for mutation in 0..7 {
+            let mut actual = expected.to_vec();
+            let mut local_extent = extent;
+            match mutation {
+                0 => actual[0].offset = 1,
+                1 => actual[2].size = 7,
+                2 => { actual.pop(); }
+                3 => actual.push(Slot { offset: extent, size: 0 }),
+                4 => actual.clear(),
+                5 => local_extent += 8,
+                6 => { actual.clear(); local_extent += 8; }
+                _ => unreachable!(),
+            }
+            let got = compare(&shapes, planned, extent, &actual, local_extent);
+            if mutation < 5 {
+                assert_eq!(got, Outcome::Panic("baseline slots differ".into()));
+            } else {
+                let Outcome::Panic(message) = got else { panic!("accepted invalid extent") };
+                assert!(message.contains("baseline local extent differs"));
+                assert!(!message.contains("baseline slots differ"));
+            }
+        }
+    }
+}
+
+#[test]
+fn later_checked_overflow_precedes_earlier_certificate_mismatches() {
+    let planned = slots(&[0, 0], 1);
+    // The second shape fails either checked size addition or checked alignment
+    // addition. The first shape and every supplied certificate already differ.
+    for shapes in [[(usize::MAX, 1), (1, 1)], [(usize::MAX, 1), (0, 8)]] {
+        for chosen in [None, Some(planned.as_slice())] {
+            for actual in [vec![], slots(&[7], 3), slots(&[7, 8, 9], 3)] {
+                assert_eq!(compare(&shapes, chosen, 2, &actual, 99),
+                    Outcome::Panic("called `Option::unwrap()` on a `None` value".into()));
+            }
+        }
+    }
+}
