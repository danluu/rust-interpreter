+use super::{optimize, reference, unchanged_body};
+use crate::{Engine, Function, Limits, Op, Program, Slot, VERSION, execute_with_engine};
+use serde_json::{Value, json};
+
+fn program(bodies: Vec<Vec<Op>>) -> Program {
+    Program {
+        version: VERSION, target: "aarch64-apple-darwin".into(), entry: 0,
+        functions: bodies.into_iter().enumerate().map(|(id, code)| Function {
+            name: format!("function-{id}"), frame_size: 16, frame_align: 8, registers: 4,
+            args: vec![], result: Slot { offset: 0, size: 8 }, code,
+        }).collect(),
+        data: vec![1, 2, 3], statics: vec![0; 24], thread_locals: vec![Slot { offset: 16, size: 8 }],
+    }
+}
+
+fn expected_part(id: usize, operations: usize, zeroes: bool, fallthrough: bool) -> Value {
+    json!({"function": id, "old_operations": operations, "new_operations": operations,
+        "redirected_edges": 0, "unreachable_operations": 0, "inserted_jumps": 0,
+        "removed_fallthrough_jumps": 0, "layout_rejected_for_growth": false,
+        "rejected_register_clearing": false, "skipped_terminal_fallthrough": fallthrough,
+        "register_zeroes_before": zeroes, "register_zeroes_proposed": zeroes})
+}
+
+fn compare(program: &mut Program, layout: bool) -> Value {
+    let mut expected = program.clone();
+    let reference = if layout {
+        reference::optimize_control_flow(&mut expected).unwrap()
+    } else {
+        reference::optimize(&mut expected, false).unwrap()
+    };
+    let actual = optimize(program, layout).unwrap();
+    assert_eq!(bincode::serialize(program).unwrap(), bincode::serialize(&expected).unwrap());
+    let actual = serde_json::to_value(actual).unwrap();
+    assert_eq!(actual, serde_json::to_value(reference).unwrap());
+    actual
+}
+
+fn owned_fields(program: &Program) -> Vec<usize> {
+    let mut pointers = Vec::new();
+    for function in &program.functions {
+        pointers.push(function.code.as_ptr() as usize);
+        for op in &function.code {
+            match op {
+                Op::Assert { message, .. } | Op::Trap { message } if !message.is_empty() => {
+                    pointers.push(message.as_ptr() as usize);
+                }
+                Op::Call { args, .. } if !args.is_empty() => pointers.push(args.as_ptr() as usize),
+                Op::CallIndirect { args, arg_sizes, .. } => {
+                    if !args.is_empty() { pointers.push(args.as_ptr() as usize); }
+                    if !arg_sizes.is_empty() { pointers.push(arg_sizes.as_ptr() as usize); }
+                }
+                Op::Switch { cases, .. } if !cases.is_empty() => pointers.push(cases.as_ptr() as usize),
+                _ => {}
+            }
+        }
+    }
+    pointers
+}
+
+#[test]
+fn terminal_ended_single_blocks_keep_storage_and_exact_reports() {
+    let original = program(vec![
+        vec![Op::Imm { dst: 0, value: 7 }, Op::Local { dst: 1, offset: 0 },
+            Op::Store { address: 1, src: 0, size: 8 }, Op::Return],
+        vec![Op::Assert { value: 0, expected: false, message: "initial register".into() }, Op::Return],
+        vec![Op::Trap { message: "kept terminal diagnostic".into() }],
+        vec![Op::Local { dst: 0, offset: 0 },
+            Op::Call { function: 5, args: vec![0], destination: 0 }, Op::Return],
+        vec![Op::Local { dst: 0, offset: 0 },
+            Op::Imm { dst: 1, value: (crate::FUNCTION_POINTER_TAG | 6) as u128 },
+            Op::CallIndirect { callee: 1, args: vec![0], arg_sizes: vec![8], destination: 0, result_size: 8 },
+            Op::Return],
+        vec![Op::Return],
+    ]);
+    let mut original = original;
+    original.functions[5].args.push(Slot { offset: 0, size: 8 });
+    for layout in [false, true] {
+        let mut candidate = original.clone();
+        let bytes = bincode::serialize(&candidate).unwrap();
+        let allocations = owned_fields(&candidate);
+        let report = compare(&mut candidate, layout);
+        let parts: Vec<_> = [(4, false), (2, true), (1, false), (3, false), (4, false), (1, false)]
+            .into_iter().enumerate().map(|(id, (len, zeroes))| expected_part(id, len, zeroes, false)).collect();
+        assert_eq!(report, json!({"functions": parts, "old_operations": 15, "new_operations": 15}));
+        assert_eq!(bincode::serialize(&candidate).unwrap(), bytes);
+        assert_eq!(owned_fields(&candidate), allocations);
+        assert_eq!(execute_with_engine(&candidate, &[], Limits::default(), Engine::Interpreter).unwrap().value, 7);
+    }
+}
+
+#[test]
+fn nonterminal_final_bodies_keep_the_existing_whole_body_skip_policy() {
+    // Even earlier terminals and unreachable bytes are retained by this policy.
+    let original = program(vec![
+        vec![Op::Imm { dst: 0, value: 7 }],
+        vec![Op::Return, Op::Assert { value: 0, expected: false, message: "unreachable read".into() }],
+        vec![Op::Trap { message: "earlier trap".into() }, Op::Imm { dst: 0, value: 1 }],
+        vec![Op::Jump { target: 1 }, Op::Imm { dst: 0, value: 1 }],
+        vec![Op::Switch { value: 0, cases: vec![(0, 1)], otherwise: 1 }, Op::Imm { dst: 0, value: 1 }],
+    ]);
+    for layout in [false, true] {
+        let mut candidate = original.clone();
+        let bytes = bincode::serialize(&candidate).unwrap();
+        let allocations = owned_fields(&candidate);
+        let report = compare(&mut candidate, layout);
+        let parts: Vec<_> = [(1, false), (2, true), (2, false), (2, false), (2, true)]
+            .into_iter().enumerate().map(|(id, (len, zeroes))| expected_part(id, len, zeroes, true)).collect();
+        assert_eq!(report, json!({"functions": parts, "old_operations": 9, "new_operations": 9}));
+        assert_eq!(bincode::serialize(&candidate).unwrap(), bytes);
+        assert_eq!(owned_fields(&candidate), allocations);
+        assert_eq!(execute_with_engine(&candidate, &[], Limits::default(), Engine::Interpreter).unwrap_err(),
+            "invalid bytecode PC");
+    }
+}
+
+#[test]
+fn earlier_terminals_and_terminal_branches_still_use_the_full_transform() {
+    let cases = vec![
+        vec![Op::Return, Op::Return],
+        vec![Op::Trap { message: "first trap".into() }, Op::Return],
+        vec![Op::Jump { target: 1 }, Op::Return],
+        vec![Op::Jump { target: 0 }],
+        vec![Op::Switch { value: 0, cases: vec![(0, 1)], otherwise: 1 }, Op::Return],
+        vec![Op::Imm { dst: 0, value: 1 }, Op::Jump { target: 0 }],
+    ];
+    assert!(unchanged_body(&[]).is_none());
+    for (index, code) in cases.into_iter().enumerate() {
+        assert!(unchanged_body(&code).is_none());
+        for layout in [false, true] {
+            let mut candidate = program(vec![code.clone()]);
+            let report = compare(&mut candidate, layout);
+            assert_eq!(report["functions"][0]["skipped_terminal_fallthrough"], false);
+            if index < 2 {
+                assert_eq!(candidate.functions[0].code.len(), 1);
+                assert_eq!(report["functions"][0]["unreachable_operations"], 1);
+            }
+        }
+    }
+}
+
+#[test]
+fn validation_rejects_every_body_before_any_optimization_and_keeps_error_order() {
+    let invalid = [
+        (vec![], "invalid function limits"),
+        (vec![Op::Imm { dst: 99, value: 1 }, Op::Return], "invalid register"),
+        (vec![Op::Jump { target: 99 }, Op::Imm { dst: 0, value: 1 }], "invalid branch"),
+        (vec![Op::Return, Op::Jump { target: 99 }, Op::Imm { dst: 0, value: 1 }], "invalid branch"),
+        (vec![Op::Imm { dst: 99, value: 1 }, Op::Jump { target: 99 }], "invalid register"),
+        (vec![Op::Jump { target: 99 }, Op::Imm { dst: 99, value: 1 }], "invalid branch"),
+    ];
+    for (bad, error) in invalid {
+        for layout in [false, true] {
+            // Function zero would lose an unreachable Return if validation did
+            // not finish checking later functions before transformation began.
+            let mut candidate = program(vec![vec![Op::Return, Op::Return], bad.clone()]);
+            let mut expected = candidate.clone();
+            let bytes = bincode::serialize(&candidate).unwrap();
+            let allocations = owned_fields(&candidate);
+            assert_eq!(optimize(&mut candidate, layout).unwrap_err(), error);
+            assert_eq!(reference::optimize(&mut expected, layout).unwrap_err(), error);
+            assert_eq!(bincode::serialize(&candidate).unwrap(), bytes);
+            assert_eq!(bincode::serialize(&expected).unwrap(), bytes);
+            assert_eq!(owned_fields(&candidate), allocations);
+        }
+    }
+}
