+use super::serialize;
+use rust_interp_bytecode::{
+    Binary, FloatBinary, FloatConversion, FloatUnary, Function, Op, Program, Slot,
+    Unary, PARTIAL_VALIDATION, VERSION, validate,
+};
+
+// Reuse the full Programs also exercised by interpreter/native call-copy tests.
+#[path = "../../bytecode/tests/common/call_copy_cases.rs"]
+mod call_copy_cases;
+
+fn minimal() -> Program {
+    Program { version: VERSION, target: "x".into(), entry: 0,
+        functions: vec![Function { name: "f".into(), frame_size: 0, frame_align: 16,
+            registers: 0, args: vec![], result: Slot { offset: 0, size: 0 }, code: vec![Op::Return] }],
+        data: vec![], statics: vec![], thread_locals: vec![] }
+}
+
+fn assert_legacy_identity(program: &Program) -> Vec<u8> {
+    let expected = bincode::serialize(program).unwrap();
+    let actual = serialize(program).unwrap();
+    assert_eq!(actual, expected);
+    // Neither encoding may mutate the graph, and the existing decoder retains
+    // every field when reading the exact artifact the exporter will publish.
+    assert_eq!(bincode::serialize(program).unwrap(), expected);
+    let decoded: Program = bincode::deserialize(&actual).unwrap();
+    assert_eq!(bincode::serialize(&decoded).unwrap(), expected);
+    actual
+}
+
+#[test]
+fn minimal_program_has_literal_v5_fixint_encoding() {
+    let program = minimal();
+    validate(&program).unwrap();
+    let mut expected = vec![5, 0, 0, 0];
+    expected.extend_from_slice(&1u64.to_le_bytes()); expected.push(b'x');
+    // Entry, function count and function-name length, followed by the name.
+    for word in [0u64, 1, 1] { expected.extend_from_slice(&word.to_le_bytes()); }
+    expected.push(b'f');
+    // Frame size/alignment, registers, args, result offset/size, and code count.
+    for word in [0u64, 16, 0, 0, 0, 0, 1] { expected.extend_from_slice(&word.to_le_bytes()); }
+    expected.extend_from_slice(&13u32.to_le_bytes()); // V5 Return discriminant.
+    for _ in 0..3 { expected.extend_from_slice(&0u64.to_le_bytes()); } // Data, statics, TLS.
+    assert_eq!(expected.len(), 122);
+    assert_eq!(assert_legacy_identity(&program), expected);
+}
+
+#[test]
+fn existing_call_copy_programs_keep_their_complete_bytes() {
+    for case in call_copy_cases::cases() {
+        validate(&case.program).unwrap();
+        assert_eq!(serialize(&case.program).unwrap(), bincode::serialize(&case.program).unwrap(),
+            "{} (runtime oracle {:?})", case.name, case.expected);
+    }
+}
+
+fn all_fields() -> Program {
+    let mut program = minimal();
+    program.target = "aarch64-apple-darwin".into();
+    program.entry = 1;
+    program.data = vec![0, 1, 127, 128, 254, 255];
+    program.statics = (0..80).map(|i| (i * 3) as u8).collect();
+    program.thread_locals = vec![Slot { offset: 48, size: 32 }, Slot { offset: 16, size: 8 }];
+    let mut function = program.functions[0].clone();
+    function.name = "all fields λ\0雪".into();
+    function.frame_size = 256;
+    function.frame_align = 64;
+    function.registers = 32;
+    function.args = vec![Slot { offset: 8, size: 16 }, Slot { offset: 96, size: 0 }];
+    function.result = Slot { offset: 128, size: 32 };
+    function.code = vec![
+        Op::Imm { dst: 0, value: 0xfedcba9876543210_0123456789abcdef },
+        Op::Local { dst: 1, offset: 144 },
+        Op::Load { dst: 2, address: 1, size: 16 },
+        Op::Store { address: 3, src: 2, size: 0 },
+        Op::Copy { dst: 3, src: 1, size: 129 },
+        Op::Binary { dst: 4, overflow: 5, op: Binary::RotateRight, a: 2, b: 6, bits: 128, signed: true },
+        Op::Unary { dst: 7, op: Unary::SwapBytes, src: 4, bits: 64 },
+        Op::Cast { dst: 8, src: 7, from: 64, to: 128, signed: false },
+        Op::Select { dst: 9, condition: 5, yes: 8, no: 2 },
+        Op::Jump { target: 0 },
+        Op::Switch { value: 9, cases: vec![(0, 1), (u128::MAX, 2)], otherwise: 3 },
+        Op::Assert { value: 5, expected: true, message: "assert λ\0".into() },
+        Op::Call { function: 1, args: vec![3, 1], destination: 10 },
+        Op::Return,
+        Op::Trap { message: "trap 雪\0".into() },
+        Op::CopyDynamic { dst: 3, src: 1, size: 11 },
