+        Op::Imm { dst: 0, value: 7 },
+        Op::Local { dst: 1, offset: 16 },
+        Op::Store { address: 1, src: 0, size: 8 },
+        Op::Local { dst: 2, offset: 16 },
+        Op::Load { dst: 3, address: 2, size: 8 },
+        Op::Assert { value: 3, expected: true, message: "kept assertion".into() },
+        Op::Local { dst: 4, offset: 32 },
+        Op::Call { function: 1, args: vec![4], destination: 4 },
+        Op::Imm { dst: 5, value: handle },
+        Op::CallIndirect { callee: 5, args: vec![4], arg_sizes: vec![8], destination: 4, result_size: 8 },
+        Op::Switch { value: 3, cases: vec![(7, 12)], otherwise: 11 },
+        Op::Trap { message: "unexpected branch".into() },
+        Op::Local { dst: 6, offset: 0 },
+        Op::Local { dst: 7, offset: 16 },
+        Op::Copy { dst: 6, src: 7, size: 8 },
+        Op::Return,
+    ], 8));
+    let mut callee = function(vec![Op::Return], 0);
+    callee.name = "identity callee".into();
+    callee.args = vec![Slot { offset: 0, size: 8 }];
+    callee.result = Slot { offset: 0, size: 8 };
+    p.functions.push(callee);
