+def installation_resource_readback(plan, *, runtime, copy_budget, read_json, sha):
+    """Recompute the complete copy reserve from authenticated saved admission.
+
+    The runtime identity/digest and controller copy_budget functions are pure.
+    Neither a Controller nor RuntimeCompiler is constructed. The separate final
+    validator still checks full current provider stamps and installed contents.
+    """
+    reference = plan['specification']
+    require(type(reference) is dict and set(reference) == {'path','sha256'}
+        and reference['path'] == str(ATTEMPT/'installation-plan-01/specification.json')
+        and sha(reference['path']) == reference['sha256'], 'exact saved installation specification required')
+    specification = read_json(reference['path'])
+    identity = runtime.identity_for(specification)
+    key = runtime.digest(identity)
+    require(type(key) is str and re.fullmatch('[a-f0-9]{64}',key)
+        and plan['runtime_key'] == key, 'independently derived installation resource key differs')
+    directory = R/'.work/runtime-compilers'/key
+    require(plan['sysroot'] == str(directory/'sysroot'), 'independently derived installation resource prefix differs')
+    admission = read_json(directory/'admission.json')
+    require(type(admission) is dict and set(admission) == {'identity','snapshots'}
+        and same(admission['identity'],identity), 'saved installation admission identity differs')
+    budget = copy_budget(specification,identity,admission['snapshots'],directory=directory)
+    require(type(budget) is dict and same(budget,plan['installation_resources']),
+        'independently recomputed installation resource summary differs')
+    return budget
 
 
