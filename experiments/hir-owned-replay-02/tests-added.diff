     use super::*;
     use validate::tests::{checked, current, tree};
 
+    // Compare the real old validate+prepare path with owned replay preparation.
+    // These helpers inspect the existing block/literal fixture; they do not
+    // implement a second validator, converter, or replay model.
+    fn assert_same_span(left: &SpanRecipe, right: &SpanRecipe) {
+        match (left, right) {
+            (SpanRecipe::Dummy, SpanRecipe::Dummy) => (),
+            (SpanRecipe::Current { owner: a, lo: alo, hi: ahi },
+                SpanRecipe::Current { owner: b, lo: blo, hi: bhi }) => {
+                assert_eq!((a, alo, ahi), (b, blo, bhi));
+            }
+            _ => panic!("prepared span recipes differ"),
+        }
+    }
+
+    fn assert_owned_matches_checked(raw: w::BodyTree, current: &Current<'_>) -> bool {
+        let checked = validate::check(raw.clone(), current);
+        let legacy = checked.as_ref().and_then(|checked| prepare(checked, current));
+        let owned = prepare_owned_replay(raw, current);
+        assert_eq!(legacy.is_some(), owned.is_some(), "preparation acceptance differs");
+        let (Some(legacy), Some(owned)) = (legacy, owned) else { return false; };
+        assert!(std::ptr::eq(legacy.current, current));
+        assert!(std::ptr::eq(owned.current, current));
+        let (left, right) = (&legacy.body, &owned.body);
+        assert_eq!(left.expected, right.expected);
+        assert_eq!(left.owner, right.owner);
+        assert_eq!((left.start, left.end), (right.start, right.end));
+        assert_eq!((left.source_start, left.source_end), (right.source_start, right.source_end));
+        assert_eq!(left.source, right.source);
+        assert_eq!(left.prefix, right.prefix);
+        assert_eq!(left.value.node.id, right.value.node.id);
+        assert_same_span(&left.value.node.span, &right.value.node.span);
+        let (ExprKind::Block(left), ExprKind::Block(right)) = (&left.value.kind, &right.value.kind)
+            else { panic!("expected existing block fixture"); };
+        assert_eq!(left.node.id, right.node.id);
+        assert_same_span(&left.node.span, &right.node.span);
+        assert!(left.statements.is_empty() && right.statements.is_empty());
+        assert_eq!(left.rules, right.rules);
+        assert_eq!(left.targeted_by_break, right.targeted_by_break);
+        let (left, right) = (left.tail.as_ref().unwrap(), right.tail.as_ref().unwrap());
+        assert_eq!(left.node.id, right.node.id);
+        assert_same_span(&left.node.span, &right.node.span);
+        let (ExprKind::Literal { span: a, value: Literal::Integer(av, at) },
+            ExprKind::Literal { span: b, value: Literal::Integer(bv, bt) }) = (&left.kind, &right.kind)
+            else { panic!("expected existing integer fixture"); };
+        assert_same_span(a, b);
+        assert_eq!((av, at), (bv, bt));
+        true
+    }
