+        // The fixture keeps its original tree, kinds and origin map, but the
+        // separately valid journal now requires different allocation origins.
+        // Current-state checks alone cannot replace the full tree/order check.
+        let current = current(&altered);
+        assert!(current_state(&current).is_some());
+        assert!(validate::check(tree(), &current).is_none());
+        assert!(!assert_owned_matches_checked(tree(), &current));
