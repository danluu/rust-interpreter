+    #[test]
+    fn owned_replay_matches_checked_rejection_of_invalid_current_state() {
+        let journal = checked();
+        for start in [0, 4, hir::ItemLocalId::INVALID.as_u32()] {
+            let mut current = current(&journal); current.start = start;
+            assert!(!assert_owned_matches_checked(tree(), &current));
+        }
+        let mut current = current(&journal);
+        current.source_end -= 1;
+        assert!(!assert_owned_matches_checked(tree(), &current)); current.source_end += 1;
+        current.source_start = u32::MAX - 3; current.source_end = u32::MAX;
+        assert!(!assert_owned_matches_checked(tree(), &current));
+        current.source_start = 100; current.source_end = 104;
+        current.resolutions.pop();
+        assert!(!assert_owned_matches_checked(tree(), &current)); current.resolutions.push(None);
+        current.references.pop();
+        assert!(!assert_owned_matches_checked(tree(), &current)); current.references.push(None);
+        current.locals.insert(w::LocalRef::Parameter(9), hir::HirId {
+            owner: current.owner, local_id: hir::ItemLocalId::from_u32(1) });
+        assert!(!assert_owned_matches_checked(tree(), &current)); current.locals.clear();
+        current.kinds = &[super::super::kinds::Kind::Block,
+            super::super::kinds::Kind::Expression(super::super::kinds::Expr::Tuple)];
+        assert!(!assert_owned_matches_checked(tree(), &current));
+    }
