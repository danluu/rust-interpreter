+    #[test]
+    fn owned_replay_matches_checked_rejection_of_tree_and_span_ranges() {
+        let journal = checked(); let current = current(&journal);
+        let mut duplicate = tree();
+        let w::ExprKind::Block(block) = &mut duplicate.value.kind else { unreachable!() };
+        block.tail.as_mut().unwrap().node.relative = 0;
+        assert!(!assert_owned_matches_checked(duplicate, &current));
+        let mut missing = tree();
+        let w::ExprKind::Block(block) = &mut missing.value.kind else { unreachable!() };
+        block.tail = None;
+        assert!(!assert_owned_matches_checked(missing, &current));
+        let mut out_of_range = tree();
+        let w::ExprKind::Block(block) = &mut out_of_range.value.kind else { unreachable!() };
+        block.tail.as_mut().unwrap().node.relative = journal.journal().end_delta;
+        assert!(!assert_owned_matches_checked(out_of_range, &current));
+        let mut wrong_root = tree(); wrong_root.value.node.relative = 1;
+        assert!(!assert_owned_matches_checked(wrong_root, &current));
+        for (lo, hi) in [(3, 4), (2, 5), (2, 1)] {
+            let mut bad_span = tree(); bad_span.value.node.span = w::SourceSpan::Relative { lo, hi };
+            assert!(!assert_owned_matches_checked(bad_span, &current));
+        }
+    }
