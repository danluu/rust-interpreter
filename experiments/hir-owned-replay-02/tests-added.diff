+    #[test]
+    fn owned_replay_matches_checked_preparation_for_current_rebasing() {
+        use super::super::journal;
+        let base = checked();
+        let nodes = vec![journal::Node { body: true, binding: false, traits: false }; 2];
+        let other_owner = hir::OwnerId { def_id: rustc_span::def_id::LocalDefId {
+            local_def_index: rustc_span::def_id::DefIndex::from_u32(1) } };
+        for start in [3, 41, hir::ItemLocalId::INVALID.as_u32() - 3] {
+            let relocated = journal::check(base.journal().clone(), &journal::Entry {
+                start, nodes: &nodes, prefix_bindings: &BTreeMap::new() }).unwrap();
+            let mut current = current(&relocated); current.start = start;
+            for owner in [current.owner, other_owner] {
+                current.owner = owner;
+                for source_start in [100, 200, u32::MAX - 4] {
+                    current.source_start = source_start; current.source_end = source_start + 4;
+                    assert!(assert_owned_matches_checked(tree(), &current));
+                }
+            }
+            let mut dummy = tree(); dummy.value.node.span = w::SourceSpan::Dummy;
+            assert!(assert_owned_matches_checked(dummy, &current));
+        }
+    }
