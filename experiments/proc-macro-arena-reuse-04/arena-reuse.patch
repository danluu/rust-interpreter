+#[cfg(test)]
+mod arena_reuse_tests {
+    use super::{Interner, Symbol, arena, fxhash};
+    use std::num::NonZero;
+    use std::panic::{AssertUnwindSafe, catch_unwind};
+
+    fn interner() -> Interner {
+        Interner {
+            arena: arena::Arena::new(),
+            names: fxhash::FxHashMap::default(),
+            strings: Vec::new(),
+            sym_base: NonZero::new(1).unwrap(),
+        }
+    }
+
+    fn assert_stale(i: &Interner, symbol: Symbol) {
+        assert!(catch_unwind(AssertUnwindSafe(|| i.get(symbol))).is_err());
+    }
+
+    #[test]
+    fn duplicate_ids_and_stale_rejection_survive_reset() {
+        let mut i = interner();
+        let a = i.intern("alpha");
+        let b = i.intern("beta");
+        assert!(i.intern("alpha") == a);
+        assert_eq!((a.0.get(), b.0.get()), (1, 2));
+        i.clear();
+        assert!(i.names.is_empty());
+        assert!(i.strings.is_empty());
+        assert_stale(&i, a);
+        assert_stale(&i, b);
+        let current = i.intern("alpha");
+        assert_eq!(current.0.get(), 3);
+        assert_eq!(i.get(current), "alpha");
+        assert_stale(&i, a);
+    }
+
+    #[test]
+    fn double_clear_and_oversized_unicode_symbol_preserve_identity() {
+        let mut i = interner();
+        let text = "雪".repeat(4096);
+        let old = i.intern(&text);
+        assert_eq!(i.get(old), text);
+        i.clear();
+        i.clear();
+        assert_eq!(i.sym_base.get(), 2);
+        assert_stale(&i, old);
+        let new = i.intern("β");
+        assert_eq!(new.0.get(), 2);
+        assert_eq!(i.get(new), "β");
+    }
+
+    #[test]
+    fn overflow_and_clear_keep_existing_nonpanicking_boundary() {
+        let mut i = interner();
+        i.sym_base = NonZero::new(u32::MAX).unwrap();
+        let last = i.intern("last");
+        assert_eq!(last.0.get(), u32::MAX);
+        assert!(catch_unwind(AssertUnwindSafe(|| i.intern("overflow"))).is_err());
+        assert_eq!(i.get(last), "last");
+        assert!(catch_unwind(AssertUnwindSafe(|| i.clear())).is_ok());
+        assert_eq!(i.sym_base.get(), u32::MAX);
+        assert!(i.names.is_empty());
+        assert!(i.strings.is_empty());
+    }
+}
