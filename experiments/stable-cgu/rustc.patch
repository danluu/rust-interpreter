+fn merge_codegen_units_stably<'tcx>(
+    cx: &PartitioningCx<'_, 'tcx>,
+    codegen_units: &mut Vec<CodegenUnit<'tcx>>,
+) {
+    let count = cx.tcx.sess.codegen_units().as_usize();
+    assert!(count >= 1);
+    assert!(codegen_units.is_sorted_by(|a, b| a.name().as_str() <= b.name().as_str()));
+
+    let mut name_builder = CodegenUnitNameBuilder::new(cx.tcx);
+    let mut buckets: Vec<_> = (0..count)
+        .map(|index| {
+            let name = name_builder.build_cgu_name(
+                LOCAL_CRATE,
+                ["stable-cgu-v1"],
+                Some(format!("{count}-{index}")),
+            );
+            let mut cgu = CodegenUnit::new(name);
+            cgu.set_symbol_name(Symbol::intern(&rustc_symbol_mangling::mangle_cgu(
+                cx.tcx,
+                LOCAL_CRATE,
+                Either::Right(cgu.name().as_str()),
+            )));
+            cgu
+        })
+        .collect();
+
+    for mut source in codegen_units.drain(..) {
+        let mut hasher = StableHasher::new();
+        source.name().as_str().hash(&mut hasher);
+        let hash: Fingerprint = hasher.finish();
+        let index = (hash.to_smaller_hash().as_u64() % count as u64) as usize;
+        let destination = &mut buckets[index];
+        for (item, data) in source.items_mut().drain(..) {
+            if let Some(previous) = destination.items_mut().insert(item, data) {
+                assert!(previous.inlined && data.inlined);
+                assert_eq!(previous, data);
+            }
+        }
+    }
+
+    for cgu in &mut buckets {
+        cgu.compute_size_estimate();
+    }
+    buckets.sort_by(|a, b| a.name().as_str().cmp(b.name().as_str()));
+    *codegen_units = buckets;
+}
+
