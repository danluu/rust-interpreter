+def crate_types(argv):
+    """Match config.rs Multi/comma parsing and lib->rlib alias deduplication."""
+    values = []
+    for index, word in enumerate(argv):
+        if word == '--crate-type':
+            require(index+1 < len(argv), 'missing crate type value')
+            values.extend(argv[index+1].split(','))
+        elif word.startswith('--crate-type='):
+            values.extend(word.removeprefix('--crate-type=').split(','))
+    require(values and all(value in ['lib', 'rlib', 'dylib', 'proc-macro', 'bin'] for value in values),
+            'unsupported or empty crate type')
+    normalized = list(dict.fromkeys('rlib' if value == 'lib' else value for value in values))
+    require(not (set(normalized) & {'bin', 'proc-macro'}) or len(normalized) == 1,
+            'mixed executable/proc-macro output role')
