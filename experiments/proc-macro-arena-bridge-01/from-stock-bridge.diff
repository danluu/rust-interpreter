+#[test]
+fn symbol_arenas_recover_after_client_and_server_panics() {
+    let _guard = SERIAL.lock().unwrap();
+    for cross in [false, true] {
+        let log = Shared::default();
+        SYMBOL_EVENTS.lock().unwrap().clear();
+        let error = run_client!(symbol_client_panic, cross, false, log).err()
+            .expect("client symbol panic missing");
+        assert_eq!(error.as_str(), Some("client-sentinel"));
+        drop(run_client!(symbol_roundtrip, cross, false, log)
+            .unwrap_or_else(|e| panic!("{:?}", e.as_str())));
+        let error = run_client!(symbol_server_panic, cross, true, log).err()
+            .expect("server symbol panic missing");
+        assert_eq!(error.as_str(), Some("server-sentinel"));
+        drop(run_client!(symbol_roundtrip, cross, false, log)
+            .unwrap_or_else(|e| panic!("{:?}", e.as_str())));
+        let events = SYMBOL_EVENTS.lock().unwrap();
+        assert_eq!(events.iter().map(|event| event.0).collect::<Vec<_>>(),
+                   ["client-panic-enter", "roundtrip-enter", "roundtrip-exit",
+                    "server-panic-enter", "roundtrip-enter", "roundtrip-exit"]);
+        assert_eq!(log.lock().unwrap().calls, [("line", 1); 4]);
+        assert_eq!(log.lock().unwrap().drops, [1, 2, 3, 4]);
+    }
+}
