+#[test]
+fn symbol_roundtrips_reuse_same_thread_and_isolate_cross_thread() {
+    let _guard = SERIAL.lock().unwrap();
+    for cross in [false, true] {
+        let log = Shared::default();
+        SYMBOL_EVENTS.lock().unwrap().clear();
+        for _ in 0..3 {
+            drop(run_client!(symbol_roundtrip, cross, false, log)
+                .unwrap_or_else(|e| panic!("{:?}", e.as_str())));
+        }
+        assert_eq!(log.lock().unwrap().calls, [("line", 1); 3]);
+        assert_eq!(log.lock().unwrap().drops, [1, 2, 3]);
+        let events = SYMBOL_EVENTS.lock().unwrap();
+        assert_eq!(events.len(), 6);
+        for pair in events.chunks_exact(2) {
+            assert_eq!(pair[0].0, "roundtrip-enter");
+            assert_eq!(pair[1].0, "roundtrip-exit");
+            assert_eq!(pair[0].1, pair[1].1);
+            assert_eq!(pair[0].1 == std::thread::current().id(), !cross);
+        }
+        if cross {
+            assert_ne!(events[0].1, events[2].1);
+            assert_ne!(events[0].1, events[4].1);
+            assert_ne!(events[2].1, events[4].1);
+        }
+    }
+}
+
+#[test]
+fn completed_invocations_reject_stale_ident_and_literal_symbols() {
+    let _guard = SERIAL.lock().unwrap();
+    let log = Shared::default();
+    drop(run_client!(retain_ident, false, false, log)
+        .unwrap_or_else(|e| panic!("{:?}", e.as_str())));
+    let error = run_client!(stale_ident, false, false, log).err()
+        .expect("stale identifier symbol accepted");
+    assert_eq!(error.as_str(), Some("use-after-free of `proc_macro` symbol"));
+    SAVED_IDENT.with_borrow_mut(|slot| *slot = None);
+    drop(run_client!(retain_literal, false, false, log)
+        .unwrap_or_else(|e| panic!("{:?}", e.as_str())));
+    let error = run_client!(stale_literal, false, false, log).err()
+        .expect("stale literal symbol accepted");
+    assert_eq!(error.as_str(), Some("use-after-free of `proc_macro` symbol"));
+    SAVED_LITERAL.with_borrow_mut(|slot| *slot = None);
+    assert!(log.lock().unwrap().calls.is_empty(), "stale symbol reached Server");
+    drop(run_client!(symbol_roundtrip, false, false, log)
+        .unwrap_or_else(|e| panic!("{:?}", e.as_str())));
+    assert_eq!(log.lock().unwrap().calls, [("line", 1)]);
+    assert_eq!(log.lock().unwrap().drops, [1, 2, 3, 4, 5]);
+}
