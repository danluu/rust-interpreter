+fn symbol_event(name: &'static str) {
+    SYMBOL_EVENTS.lock().unwrap().push((name, std::thread::current().id()));
+}
+
+// Only ASCII identifiers use the local validation fast path. Unicode is tested
+// through real literal escaping/interning, without inventing a Unicode server.
+fn assert_symbol_payloads() {
+    let span = Span::call_site();
+    let first = Ident::new("arena_name", span);
+    let duplicate = Ident::new("arena_name", span);
+    let raw = Ident::new_raw("type", span);
+    let unicode = Literal::string("雪_β_☃");
+    let escaped = Literal::string("line\n\"quote\"");
+    let large_name = "x".repeat(8193);
+    let large = Ident::new(&large_name, span);
+    assert_eq!(first.to_string(), "arena_name");
+    assert_eq!(duplicate.to_string(), "arena_name");
+    assert_eq!(raw.to_string(), "r#type");
+    assert_eq!(unicode.to_string(), "\"雪_β_☃\"");
+    assert_eq!(escaped.to_string(), "\"line\\n\\\"quote\\\"\"");
+    assert_eq!(large.to_string(), large_name);
+    assert_eq!(first.to_string(), "arena_name");
+    assert_eq!(unicode.to_string(), "\"雪_β_☃\"");
+}
+
+fn symbol_roundtrip(input: TokenStream) -> TokenStream {
+    symbol_event("roundtrip-enter");
+    assert_symbol_payloads();
+    assert_eq!(Span::call_site().line(), 1);
+    symbol_event("roundtrip-exit");
+    input
+}
+
+fn symbol_nested_client(input: TokenStream) -> TokenStream {
+    symbol_event("inner-enter");
+    let name = Ident::new("inner_symbols", Span::call_site());
+    let text = Literal::string("inner_雪");
+    let large_name = "n".repeat(8193);
+    let large = Ident::new(&large_name, Span::call_site());
+    let output = nested_client(input);
+    assert_eq!(name.to_string(), "inner_symbols");
+    assert_eq!(text.to_string(), "\"inner_雪\"");
+    assert_eq!(large.to_string(), large_name);
+    symbol_event("inner-exit");
+    output
+}
+
+fn symbol_outer_client(input: TokenStream) -> TokenStream {
+    symbol_event("outer-enter");
+    let name = Ident::new("outer_symbols", Span::call_site());
+    let text = Literal::string("outer_β");
+    let large_name = "o".repeat(8193);
+    let large = Ident::new(&large_name, Span::call_site());
+    let output = outer_client(input);
+    assert_eq!(name.to_string(), "outer_symbols");
+    assert_eq!(text.to_string(), "\"outer_β\"");
+    assert_eq!(large.to_string(), large_name);
+    symbol_event("outer-exit");
+    output
+}
+
+fn retain_ident(input: TokenStream) -> TokenStream {
+    SAVED_IDENT.with_borrow_mut(|slot| {
+        *slot = Some(Ident::new("saved_arena_name", Span::call_site()));
+    });
+    input
+}
+
+fn stale_ident(input: TokenStream) -> TokenStream {
+    SAVED_IDENT.with_borrow(|slot| {
+        let _ = slot.as_ref().expect("missing saved identifier").to_string();
+    });
+    input
+}
+
+fn retain_literal(input: TokenStream) -> TokenStream {
+    SAVED_LITERAL.with_borrow_mut(|slot| *slot = Some(Literal::string("saved_雪")));
+    input
+}
+
+fn stale_literal(input: TokenStream) -> TokenStream {
+    SAVED_LITERAL.with_borrow(|slot| {
+        let _ = slot.as_ref().expect("missing saved literal").to_string();
+    });
+    input
+}
+
+fn symbol_client_panic(input: TokenStream) -> TokenStream {
+    symbol_event("client-panic-enter");
+    assert_symbol_payloads();
+    client_panic(input)
+}
+
+fn symbol_server_panic(input: TokenStream) -> TokenStream {
