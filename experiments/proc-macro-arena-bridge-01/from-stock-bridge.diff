+#[test]
+fn nested_dispatch_preserves_outer_and_inner_symbol_values() {
+    let _guard = SERIAL.lock().unwrap();
+    for cross in [false, true] {
+        let log = Shared::default();
+        SYMBOL_EVENTS.lock().unwrap().clear();
+        CLIENT_THREADS.lock().unwrap().clear();
+        drop(run_client!(symbol_outer_client, cross, false, log)
+            .unwrap_or_else(|e| panic!("{:?}", e.as_str())));
+        let events = SYMBOL_EVENTS.lock().unwrap();
+        assert_eq!(events.iter().map(|event| event.0).collect::<Vec<_>>(),
+                   ["outer-enter", "inner-enter", "inner-exit", "outer-exit"]);
+        assert_eq!(events[0].1, events[3].1);
+        assert_eq!(events[1].1, events[2].1);
+        assert_ne!(events[0].1, events[1].1);
+        assert_eq!(events[0].1 == std::thread::current().id(), !cross);
+        let threads = CLIENT_THREADS.lock().unwrap();
+        assert_eq!(*threads, [("outer", events[0].1), ("inner", events[1].1)]);
+        assert_eq!(log.lock().unwrap().calls,
+                   [("nested-enter", 1), ("line", 90_000), ("nested-exit", 1), ("line", 1)]);
+        assert_eq!(log.lock().unwrap().drops, [2, 1]);
+    }
+}
